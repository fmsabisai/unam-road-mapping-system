# .env.example
# =============
# Copy this file to .env and fill in your values.
# The application reads these via environment variables.
#
#   cp .env.example .env

# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string with PostGIS enabled
ROAD_DB_DSN=postgresql://road_user:secret@localhost/roadmap

# ── Data paths ─────────────────────────────────────────────────────────────
# Directory where the Raspberry Pi stores captured frames + metadata.json
SURVEY_DATA_DIR=/mnt/data/road_survey

# ── Camera (Raspberry Pi) ──────────────────────────────────────────────────
# Serial port for the GPS module
GPS_PORT=/dev/ttyAMA0
GPS_BAUD=9600

# Camera resolution
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080

# Seconds between frame captures
FRAME_INTERVAL=0.5

# ── Camera intrinsics ──────────────────────────────────────────────────────
# Focal length in pixels (from cv2.calibrateCamera)
FOCAL_PX=1400.0

# Camera mounting height above road surface (metres)
CAM_HEIGHT_M=1.5

# ── Anomaly thresholds ─────────────────────────────────────────────────────
STRAIGHT_RUN_THRESHOLD_M=500
NARROW_ROAD_THRESHOLD_M=3.5
DARK_LUMINANCE_THRESHOLD=40
CLEARANCE_WARNING_M=2.0
POTHOLE_Z_THRESHOLD=2.0
